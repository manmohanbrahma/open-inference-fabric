{
 "uid": "oif-fleet",
 "title": "OIF Fleet",
 "description": "GPU utilisation, memory, power, temperature and clocks for every GPU of both vendors, from the oif:* recording rules.",
 "tags": [
  "oif"
 ],
 "editable": true,
 "schemaVersion": 41,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "30s",
 "timezone": "browser",
 "graphTooltip": 1,
 "templating": {
  "list": [
   {
    "name": "vendor",
    "label": "Vendor",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(oif:gpu_util_ratio, vendor)",
     "refId": "vendor"
    },
    "definition": "label_values(oif:gpu_util_ratio, vendor)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "refresh": 2,
    "sort": 1,
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   },
   {
    "name": "node",
    "label": "Node",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(oif:gpu_util_ratio, node)",
     "refId": "node"
    },
    "definition": "label_values(oif:gpu_util_ratio, node)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "refresh": 2,
    "sort": 1,
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Now",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Utilisation",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "oif:gpu_util_ratio{vendor=~\"$vendor\", node=~\"$node\"}",
     "legendFormat": "{{vendor}} {{model}} gpu{{gpu}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "noValue": "0",
     "color": {
      "mode": "fixed",
      "fixedColor": "#8a8f8c"
     },
     "decimals": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "/^nvidia.*/"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#76B900"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "/^amd.*/"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#ED1C24"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
