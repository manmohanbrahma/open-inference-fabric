  {
   "id": 8,
   "type": "text",
   "title": "",
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 24,
    "h": 2
   },
   "options": {
    "mode": "markdown",
    "content": "Run:ai's queue metrics count **NVIDIA GPUs only**; AMD GPU use is in the rows above and in the per-vendor caps below (ADR-015)."
   }
  },
  {
   "id": 9,
   "type": "table",
   "title": "Project quotas (Run:ai)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 12,
    "h": 8
   },
   "description": "Deserved (quota), allocated and pending GPUs per Run:ai project.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "oif:project_gpu_deserved",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "oif:project_gpu_allocated or oif:project_gpu_deserved * 0",
     "legendFormat": "",
     "refId": "B",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "oif:project_gpu_pending or oif:project_gpu_deserved * 0",
     "legendFormat": "",
     "refId": "C",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "project": "Project",
       "Value #A": "Quota (GPUs)",
       "Value #B": "Allocated",
       "Value #C": "Pending"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "noValue": "0",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "showHeader": true
   }
  },
