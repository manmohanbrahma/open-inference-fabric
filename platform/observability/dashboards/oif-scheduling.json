  {
   "id": 5,
   "type": "timeseries",
   "title": "GPUs in use by namespace",
   "description": "Running pods' GPU requests per vendor and namespace (Run:ai project namespaces are runai-<project>). No data: see https://github.com/manmohanbrahma/open-inference-fabric/blob/main/docs/guides/07-observability.md#troubleshooting",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (vendor, namespace) (oif:gpu_requested{vendor=~\"$vendor\", phase=\"Running\"})",
     "legendFormat": "{{vendor}} {{namespace}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": true
     },
     "color": {
      "mode": "fixed",
      "fixedColor": "#8a8f8c"
     },
     "min": 0,
     "decimals": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "/^nvidia.*/"
