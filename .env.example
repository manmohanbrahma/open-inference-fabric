# Copy to .env (untracked) and fill in. Never commit .env.

# Host and network
HOST_IP=                 # address of the server's main interface
METALLB_RANGE=           # free range on the same subnet, e.g. A.B.C.240-A.B.C.244
INSTALL_DIR=             # data folder for images, volumes and results, e.g. /data/oif

# GPUs (PCI addresses from `lspci -D | grep -Ei 'vga|3d|display'`)
NVIDIA_GPUS=             # GPUs given to Kubernetes, comma-separated, empty = all
AMD_GPUS=                # GPUs given to Kubernetes, comma-separated, empty = all supported
ISOLATE_GPUS=            # AMD display cards kept away from Kubernetes with vfio; "none" for none, empty = ask

# Model access
HF_TOKEN=                # Hugging Face token (for gated models)
RUNAI_DOMAIN=            # Run:ai UI and workloads; empty = runai.<first MetalLB address>.sslip.io (no DNS server needed)

# Admin credentials (set your own; used only to create Kubernetes Secrets)
RUNAI_ADMIN_EMAIL=
RUNAI_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Defaults for v0.1
MODEL_ID=Qwen/Qwen3-0.6B
RUNAI_PATCHES=            # oif patches to Run:ai (patches/runai/, e.g. AMD GPU counts): empty = all, none = stock Run:ai
