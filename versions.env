# Every pinned version used by oif. Change versions here only; each task adds the pins it needs.
# shellcheck shell=bash disable=SC2034

OIF_VERSION=0.1.0-dev

# Tools
HELM_VERSION=v3.22.1

# Host (T-102): packages from the Ubuntu archive of the running release
NVIDIA_DRIVER_BRANCH=595-server            # headless server driver, open kernel modules, prebuilt and signed (no DKMS)
NVIDIA_DRIVER_MIN=580                      # Dynamo and CUDA 13 need 580 or newer

# Kubernetes (T-103). Checksums are of the upstream files at these versions; oif refuses a file that differs.
KUBERNETES_VERSION=1.35.9                  # ADR-001; newer minors exist, 1.35 is inside Run:ai's and Dynamo's support
KUBERNETES_PKG_REV=1.1                     # pkgs.k8s.io package revision (kubelet=1.35.9-1.1)
KUBE_VIP_IMAGE=ghcr.io/kube-vip/kube-vip:v1.2.4@sha256:dde4c0669d9058c74c69c0bc2f0122e26900e1e4b913c03577cb6e4e28083079   # API address of a multi-node control plane (static pod, ARP)
KUBELET_MAX_PODS=250
CALICO_VERSION=v3.32.2
CALICO_CRDS_SHA256=cb46786692404fb7955c6d31329c667d0dd8f1ff4821dc7869d0156c93d3a859
CALICO_OPERATOR_SHA256=4e372754e4e1c3a61cf7c0ceb9bc9fff2f78aa6575dcadcb5ea4e716bb00dffa
LOCAL_PATH_VERSION=v0.0.37
LOCAL_PATH_SHA256=9781b39c24f3f651bd6d6e41b561e04e4904bbdb6d4f8c7a6009df3a702dcd65
METALLB_VERSION=v0.16.0
METALLB_SHA256=b0b9be2802f10aa32d45308b4457d06cde0c70544712c8d0cf5511657ffd2b69
LONGHORN_VERSION=1.12.1                     # newest "stable" Longhorn (1.13.0 is "latest"); multi-node platform data, ADR-021
LONGHORN_SHA256=c8cf4b35a9d872cd5f7e44fd26d8e6ac7c2abaee42f4e2f2a0b0ebbc6e3a6116   # chart longhorn-1.12.1.tgz (matches charts.longhorn.io index)
HELM_SHA256=896cf63684a42a723d61c980369d6e588330927deb13676ca0d85006dd6da0ea
BUSYBOX_IMAGE=docker.io/library/busybox:1.37.0   # local-path helper pods and the smoke test

# NVIDIA GPU Operator (T-104): chart from helm.ngc.nvidia.com, checksum from its index
GPU_OPERATOR_VERSION=v26.7.1                # newest inside Run:ai 3.0's support matrix (25.10 - 26.7.1)
GPU_OPERATOR_SHA256=fdce4cba07db5ddb6dfd0bdf61276a44c24136f2b193bc6ebc81dd1b0f049777
CUDA_SAMPLE_IMAGE=nvcr.io/nvidia/k8s/cuda-sample:vectoradd-cuda12.5.0   # GPU test pod (runs on newer drivers)

# Prometheus, ingress and Run:ai (T-105)
KPS_VERSION=92.3.0                         # kube-prometheus-stack; Run:ai needs 88.6.5 or newer
KPS_SHA256=48399b911fa91b353e0c3d5e32c1cb7a67a168566549723553154ffd7be5d1fa
HAPROXY_INGRESS_VERSION=1.54.2             # HAProxy Kubernetes Ingress Controller chart (HAProxy 3.2.15)
HAPROXY_INGRESS_SHA256=5319098c9a5f62136de60c44cd0918f997b81e19ff70b5cc1ad9c9b6d995ed90
RUNAI_VERSION=3.0.20                       # open-source Run:ai; installer from the GitHub release
RUNAI_INSTALLER_SHA256=d9563e28ee7f14a5720926b1aa1f037dd8c888d4482516711f7dc5b23ebf5621
PROMETHEUS_VERSION=3.15.0                  # promtool for the oif:* rule tests; same version as the cluster Prometheus (kube-prometheus-stack 92.3.0)
PROMETHEUS_SHA256=2a542df32eac02ee17b9d844fb2aa1de00dafa5476579ba8a3ba862e9d572ea0

# AMD GPU Operator (T-111): chart from rocm.github.io/gpu-operator, checksum from its index; component images pinned
AMD_GPU_OPERATOR_VERSION=v1.5.1
AMD_GPU_OPERATOR_SHA256=efbd23fe2297350ac23dedf1b916874138f57dd2796b444d1a7f241eaaefc6a8
AMD_DEVICE_PLUGIN_IMAGE=docker.io/rocm/k8s-device-plugin:1.31.0.11
AMD_NODE_LABELLER_IMAGE=docker.io/rocm/k8s-device-plugin:labeller-1.31.0.11
AMD_UTILS_IMAGE=docker.io/rocm/gpu-operator-utils:v1.5.1
AMD_METRICS_EXPORTER_IMAGE=docker.io/rocm/device-metrics-exporter:v1.5.1

# Run:ai templates for AMD GPUs (T-115): PyTorch on ROCm (gfx1100 supported) and the JupyterLab installed into it at start
ROCM_PYTORCH_IMAGE=docker.io/rocm/pytorch:rocm10.1.0_ubuntu24.04_py3.12_pytorch_release_2.14.0@sha256:099f59a3bee9c436f5cc57db6bc6076fdeda579c57e9e22ae40f856d5905b3e4
JUPYTERLAB_VERSION=4.6.4

# Run:ai patches (T-115): source of the running Run:ai version, the Go toolchain that builds it, crane to package it
RUNAI_SOURCE_SHA256=261fe61ead01887a97686be4cffaf812df81c15cd5110be353a8ded3c669da81   # codeload tar.gz of tag RUNAI_VERSION
GO_BUILD_IMAGE=docker.io/library/golang:1.27.1-bookworm@sha256:8d48e12ec56735e9358640898b9d9b9fcca110612ed8a5567438c0a1baa24e66
CRANE_VERSION=v0.22.1
CRANE_SHA256=0ab7a1d6932a213aed964ce97666c3077fe691c8606413674a8b3e0b9ec4cda0   # go-containerregistry_Linux_x86_64.tar.gz
NODE_BUILD_IMAGE=docker.io/library/node:22-bookworm@sha256:63538dfe497cc29dfafdda25ada09b46db68a3f4cc205abf1f5d6bf0913f3384
