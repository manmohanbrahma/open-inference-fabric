# Every pinned version used by oif. Change versions here only; each task adds the pins it needs.
# shellcheck shell=bash disable=SC2034

OIF_VERSION=0.1.0-dev

# Tools
HELM_VERSION=v3.19.0

# Host (T-102): packages from the Ubuntu archive of the running release
NVIDIA_DRIVER_BRANCH=595-server            # headless server driver, open kernel modules, prebuilt and signed (no DKMS)
NVIDIA_DRIVER_MIN=580                      # Dynamo and CUDA 13 need 580 or newer
